# Test Environment Variables
# Copy this file to .env.test and configure for your test environment

# Server
NODE_ENV=test
PORT=5001

# Database
MONGODB_URI=mongodb://localhost:27017/auth-master-test

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets (use different secrets for testing)
JWT_ACCESS_SECRET=test-access-secret-key-change-this-in-production
JWT_REFRESH_SECRET=test-refresh-secret-key-change-this-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Email Configuration (use test email service)
EMAIL_HOST=smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_USER=your-mailtrap-user
EMAIL_PASSWORD=your-mailtrap-password
EMAIL_FROM=Test Auth System

# OTP Configuration
OTP_EXPIRY_MINUTES=10

# Security
BCRYPT_SALT_ROUNDS=10
