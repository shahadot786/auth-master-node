# Server Configuration
NODE_ENV=development
PORT=5000

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/robust-auth-db
# For MongoDB Atlas, use:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/robust-auth-db?retryWrites=true&w=majority

# Redis Configuration (for refresh tokens and OTP)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# For Redis Cloud or other hosted Redis:
# REDIS_HOST=your-redis-host.com
# REDIS_PASSWORD=your-redis-password

# JWT Configuration
JWT_ACCESS_SECRET=your-super-secret-access-token-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-change-this-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Bcrypt Configuration
BCRYPT_SALT_ROUNDS=12

# Email Configuration (Gmail SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=noreply@yourapp.com

# For Gmail: Enable 2FA and create App Password at https://myaccount.google.com/apppasswords
# For other SMTP services, adjust EMAIL_HOST, EMAIL_PORT, and EMAIL_SECURE accordingly

# OTP Configuration
OTP_EXPIRY_MINUTES=10

# Cookie Configuration
COOKIE_SECRET=your-cookie-secret-key-change-this-in-production

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
# For multiple origins, use comma-separated values:
# CORS_ORIGIN=http://localhost:3000,https://yourdomain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5

# Application URL (for email links)
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
